<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LemonAID.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    IsTabStop="True">

    <!-- Root Grid is Transparent so Mica Alt / Acrylic shines through -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Top Title Bar -->
        <Grid x:Name="TopTitleBarGrid" Grid.Row="0" Padding="20,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse x:Name="BrandAccentDot" Width="14" Height="14" />
                <TextBlock x:Name="BrandTitleText" Text="LemonAID" FontWeight="Bold" FontSize="15" />
                <Border x:Name="BrandPillBorder" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" BorderThickness="1">
                    <TextBlock x:Name="BrandPillText" Text="Mica Alt · Dynamic Accent" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <!-- Right-aligned controls padded away from Windows min/max/close caption buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,138,0">
                <ToggleButton x:Name="PinToggleBtn" Content="📌 Pin" FontSize="12" Checked="PinToggleBtn_Changed" Unchecked="PinToggleBtn_Changed" />
                <Button Content="⬇ Hide to Tray" FontSize="12" Click="HideToTray_Click" />
                <Button Content="🎓 Onboarding" FontSize="12" Click="OpenOnboarding_Click" />
                <Button Content="⚙ Settings" FontSize="12" Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>

        <!-- Main Split Workspace -->
        <Grid Grid.Row="1" Padding="36,24" ColumnSpacing="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Radial Wheel Container -->
            <Grid Grid.Column="0" Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Outer Translucent Ring -->
                <Ellipse x:Name="MainWheelOuterEllipse" Width="372" Height="372" StrokeThickness="2" />

                <!-- Dynamic Wedge Canvas -->
                <Canvas x:Name="WheelCanvas" Width="380" Height="380" />

                <!-- Center Hub -->
                <Border x:Name="MainWheelCenterBorder" Width="118" Height="118" CornerRadius="59"
                        BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CenterSizeText" Text="2.4 MB"
                                   FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CenterCountText" Text="Drop files here"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT: Mode Switcher, Key Cues & Active File Queue -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="20">
                <!-- Wheel Mode Selector Pills -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ConverterTabBtn" Content="File Converter (Shift)" Click="ConverterTab_Click"
                            CornerRadius="18" Padding="14,8" FontWeight="SemiBold" />
                    <Button x:Name="ToolsTabBtn" Content="File Tools (Alt)" Click="ToolsTab_Click"
                            CornerRadius="18" Padding="14,8" FontWeight="SemiBold" />
                    <Button x:Name="ActionsTabBtn" Content="File Actions (Ctrl)" Click="ActionsTab_Click"
                            CornerRadius="18" Padding="14,8" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Active Mode Title & Subtitle -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ModeTitleText" Text="File Converter"
                               FontSize="34" FontWeight="Bold" />
                    <TextBlock x:Name="ModeSubtitleText"
                               Text="Convert files locally into your chosen format. Results are saved next to the originals."
                               FontSize="14" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 1. Drag files / 2. Tap Keycap Card (Translucent Acrylic/Mica Layer) -->
                <Border x:Name="InstructionCardBorder" BorderThickness="1" CornerRadius="14" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="Step1LabelText" Text="1. Drag files" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="Browse Files..." Click="BrowseFiles_Click" FontSize="12" CornerRadius="8" />
                            <Button Content="Load Sample Image" Click="CreateSampleFile_Click" FontSize="12" CornerRadius="8" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="Step2LabelText" Text="2. Tap" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border x:Name="KeycapBorder" BorderThickness="1.5" CornerRadius="8" Padding="14,6">
                                <StackPanel>
                                    <TextBlock x:Name="KeycapSymbolText" Text="⇧" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="KeycapLabelText" Text="shift" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="KeycapHintText" Text="or hold Left-Click anywhere in Explorer + tap Shift" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Loaded Files & Hovered Sector Info -->
                <Border x:Name="SummaryCardBorder" CornerRadius="12" Padding="16,12" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SelectedFilesSummaryText"
                                   Text="No files loaded yet — drop any file onto the window or click 'Load Sample Image'."
                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HoveredSectorDescriptionText"
                                   Text="Hover or click a radial sector on the Lemon Wheel to execute."
                                   FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom Translucent Status Bar -->
        <Border x:Name="BottomStatusBarBorder" Grid.Row="2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready · Global Hook Active (Hold Left-Click + Shift) · Results saved beside originals"
                           FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="OutputModeBadge"
                           Text="Output: Beside Originals" FontSize="12" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- 6-STEP ONBOARDING OVERLAY (Dynamic System Accent Gradient + Acrylic Backdrop) -->
        <Grid x:Name="OnboardingOverlay" Grid.RowSpan="3" Background="#B3000000" Visibility="Visible">
            <Border x:Name="OnboardingCardBorder" Width="680" Height="440" CornerRadius="48"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="44,36">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Back Button -->
                    <Button x:Name="OnboardingBackBtn" Content="← Back"
                            Click="OnboardingBack_Click"
                            CornerRadius="14" HorizontalAlignment="Left" />

                    <!-- Center Onboarding Step Content -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="540">
                        <TextBlock x:Name="OnboardingStepTag" Text="Welcome to"
                                   FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="OnboardingStepTitle" Text="LemonAID"
                                   FontSize="54" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="OnboardingStepBody"
                                   Text="Zero-click contextual radial menus for instant offline file conversion, editing tools, and file actions."
                                   FontSize="16"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                        <StackPanel x:Name="OnboardingExtraPanel" Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,8,0,0">
                            <Button x:Name="OnboardingFolderBtn" Content="Allow Custom Folder Access..."
                                    Click="SelectCustomFolder_Click"
                                    CornerRadius="16" Padding="16,8" />
                            <ToggleSwitch x:Name="LaunchAtLoginToggle" Header="Launch at login"
                                          IsOn="True" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom Continue Button + 6 Progress Dots -->
                    <StackPanel Grid.Row="2" Spacing="16" HorizontalAlignment="Center">
                        <Button x:Name="OnboardingNextBtn" Content="Continue"
                                Click="OnboardingNext_Click"
                                FontWeight="Bold" FontSize="15"
                                CornerRadius="22" Padding="36,12" HorizontalAlignment="Center" />

                        <StackPanel x:Name="ProgressDotsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SETTINGS OVERLAY (Mica Alt / Acrylic & Dynamic Theme Controls) -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#B3000000" Visibility="Collapsed">
            <Border x:Name="SettingsCardBorder" Width="540" CornerRadius="20" BorderThickness="1.5"
                    Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="SettingsHeaderTitle" Text="LemonAID Settings" FontSize="22" FontWeight="Bold" />

                    <!-- Backdrop & Dynamic Theme Selector -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SettingsAppearanceLabel" Text="Window Material &amp; Dynamic Color Theme" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="BackdropComboBox" Header="Backdrop Material" SelectedIndex="0" Width="220"
                                      SelectionChanged="BackdropComboBox_SelectionChanged">
                                <ComboBoxItem Content="Mica Alt (BaseAlt)" />
                                <ComboBoxItem Content="Desktop Acrylic (Translucent)" />
                            </ComboBox>

                            <ComboBox x:Name="ThemeModeComboBox" Header="Color Mode" SelectedIndex="0" Width="220"
                                      SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Windows Dynamic (Auto)" />
                                <ComboBoxItem Content="Dark Mode" />
                                <ComboBoxItem Content="Light Mode" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SettingsFolderLabel" Text="Folders &amp; Output Location" FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsFolderStatusText"
                                   Text="Default: Results are saved next to the originals."
                                   FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Content="Choose Custom Output Folder..." Click="SelectCustomFolder_Click" />
                            <Button Content="Reset to Beside Originals" Click="ResetOutputFolder_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SettingsShortcutsLabel" Text="Modifier Key Shortcuts" FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsShortcutsBody"
                                   Text="• Shift: File Converter Wheel (PDF, PNG, WEBP, HEIC, TIFF, AVIF)&#x0a;• Alt: File Tools Wheel (Compress, Metadata, Edit, Annotate, Add BG, Crop, Redact)&#x0a;• Ctrl: File Actions Wheel (Nearby Share, Float, Copy, Move, Copy Path, Terminal)"
                                   FontSize="12" LineHeight="20" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="PowerToys Background &amp; Headless Mode" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColorLight1}" />
                        <ToggleSwitch x:Name="SettingsCloseToTrayToggle"
                                      Header="Keep running in System Tray when closing window"
                                      IsOn="True" Toggled="BackgroundToggles_Changed" />
                        <ToggleSwitch x:Name="SettingsStartHeadlessToggle"
                                      Header="Start silently in headless background mode"
                                      IsOn="False" Toggled="BackgroundToggles_Changed" />
                        <ToggleSwitch x:Name="SettingsLaunchToggle"
                                      Header="Launch LemonAID at Windows sign-in (--headless)"
                                      IsOn="True" Toggled="BackgroundToggles_Changed" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⏻ Quit Background Process" Click="QuitProcess_Click"
                                CornerRadius="12" Padding="16,8" />
                        <Button Grid.Column="2" x:Name="SettingsDoneBtn" Content="Done" Click="CloseSettings_Click"
                                FontWeight="Bold" Padding="24,8" CornerRadius="12" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
