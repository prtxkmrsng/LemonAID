<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LemonAID.RadialOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LemonAID Overlay">

    <Grid x:Name="RootGrid"
          Width="380" Height="380"
          Background="Transparent"
          UseSystemFocusVisuals="False"
          RenderTransformOrigin="0.5,0.5"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">

        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootWheelTransform" />
        </Grid.RenderTransform>

        <!-- Full-bleed 380x380 circle matching the exact elliptic window region -->
        <Ellipse x:Name="OuterRingEllipse"
                 Width="380" Height="380"
                 StrokeThickness="3"
                 UseSystemFocusVisuals="False"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <!-- Dynamic Radial Wedges -->
        <Canvas x:Name="OverlayWheelCanvas"
                Width="380" Height="380"
                UseSystemFocusVisuals="False" />

        <!-- Center Info Hub -->
        <Border x:Name="CenterHubBorder"
                Width="122" Height="122" CornerRadius="61"
                BorderThickness="2"
                UseSystemFocusVisuals="False"
                RenderTransformOrigin="0.5,0.5"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <CompositeTransform x:Name="CenterHubTransform" />
            </Border.RenderTransform>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" Padding="8">
                <TextBlock x:Name="OverlayModeBadge" Text="SHIFT · CONVERT"
                           FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlaySizeText" Text="2.4 MB"
                           FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayTargetText" Text="Release on wedge"
                           FontSize="10"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
