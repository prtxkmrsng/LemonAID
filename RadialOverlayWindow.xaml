<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LemonAID.RadialOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LemonAID Overlay">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Width="380" Height="380"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.5"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">

        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootWheelTransform" />
        </Grid.RenderTransform>

        <!-- Outer Translucent Ring with Subtle Stroke -->
        <Ellipse x:Name="OuterRingEllipse"
                 Width="356" Height="356"
                 StrokeThickness="1.5"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <!-- Dynamic Radial Wedges -->
        <Canvas x:Name="OverlayWheelCanvas" Width="380" Height="380" />

        <!-- Center Info Hub -->
        <Border x:Name="CenterHubBorder"
                Width="120" Height="120" CornerRadius="60"
                BorderThickness="1.5"
                RenderTransformOrigin="0.5,0.5"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <CompositeTransform x:Name="CenterHubTransform" />
            </Border.RenderTransform>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" Padding="6">
                <TextBlock x:Name="OverlayModeBadge" Text="SHIFT · CONVERT"
                           FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlaySizeText" Text="0 B"
                           FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayTargetText" Text="Release on wedge"
                           FontSize="11"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="112" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
