<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LemonAID.RadialOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LemonAID Overlay">

    <Grid x:Name="RootGrid"
          Width="380" Height="380"
          Background="#141518"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">

        <!-- Outer Lemon Ring -->
        <Ellipse Width="376" Height="376"
                 Fill="#18191D"
                 Stroke="#FACC15"
                 StrokeThickness="3"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <!-- Dynamic Radial Wedges -->
        <Canvas x:Name="OverlayWheelCanvas" Width="380" Height="380" />

        <!-- Center Info Hub -->
        <Border Width="122" Height="122" CornerRadius="61"
                Background="#111215" BorderBrush="#FACC15" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" Padding="8">
                <TextBlock x:Name="OverlayModeBadge" Text="SHIFT · CONVERT"
                           FontSize="9" FontWeight="Bold" Foreground="#FACC15"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlaySizeText" Text="2.4 MB"
                           FontSize="17" FontWeight="Bold" Foreground="#FAFAFA"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayTargetText" Text="Release on wedge"
                           FontSize="10" Foreground="#A1A1AA"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
